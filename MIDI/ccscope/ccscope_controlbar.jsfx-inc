// ===================================================================
// CCSCOPE CONTROL BAR - the cells, the lists, the pointer
// ===================================================================
// A library file (.jsfx-inc) imported by ccscope.jsfx.
//
// OWNS: everything between the top of the canvas and the plot frame -- cell
// geometry from measured text, the two tiers (with and without labels), hit
// testing, the wheel, right-click, the open list and its scrolling thumb, and the
// corner-cut primitives the cells are drawn with.
//
// READS: the CTRL_* constants, PLOT_LEFT/PLOT_RIGHT, BAR_FONT and FONT_SIZE from
// ccscope.jsfx @init; mem[MEM_CTL_X..] from ccscope_utils.jsfx-inc; mouse_x,
// mouse_y, mouse_cap, mouse_wheel from the host.
// WRITES: slider1..slider7 through ctl_set() (with sliderchange(), so automation
// and the Param button follow), and the g_menu_*/g_hover_cell state.
//
// No other panel calls into this file and this file calls no other panel.
// ===================================================================

@init

// ========== CONTROL BAR: WHAT EACH CELL DRIVES ==========
// The bar is ordered by what you reach for first, not by the order of the slider
// declarations, so the mapping lives here once and nowhere else.
function ctl_slider_number(i) (
  i == 1 ? 1 : i == 2 ? 6 : i == 3 ? 3 : i == 4 ? 5 : i == 5 ? 7 : i == 6 ? 2 : 4;
);

function ctl_is_selector(i) ( i <= 5 ? 1 : 0 );

// The two buttons carry their text in the key, not in a value: dropping the
// labels in a narrow window would leave FREEZE and CLEAR blank, so they keep
// theirs while the selectors go to values only.
function ctl_shows_key(i) ( (i >= 6 || g_bar_has_labels) ? 1 : 0 );

function ctl_min(i) (
  i == 1 ? 0 : i == 2 ? 0 : i == 3 ? 1 : i == 4 ? 0 : i == 5 ? 0 : 0;
);

function ctl_max(i) (
  i == 1 ? 127 : i == 2 ? 16 : i == 3 ? 30 : i == 4 ? 2 : i == 5 ? 1 : 1;
);

function ctl_default(i) (
  i == 1 ? 0 : i == 2 ? 0 : i == 3 ? 10 : i == 4 ? 0 : i == 5 ? 0 : 0;
);

function ctl_get(i) local(s) (
  s = ctl_slider_number(i);
  s == 1 ? slider1 : s == 2 ? slider2 : s == 3 ? slider3 : s == 4 ? slider4 : s == 5 ? slider5 : s == 6 ? slider6 : slider7;
);

// The documented form is sliderchange(sliderN): it tells REAPER the value was set
// from code, so embedded displays and the Param list follow. It does not write
// automation -- slider_automate() would -- so a cell is a setting, not a source
// of automation. The clamp lives here, so no caller can store an out-of-range
// value that the slider would then refuse to show.
function ctl_set(i, v) local(s) (
  s = ctl_slider_number(i);
  v = max(ctl_min(i), min(ctl_max(i), v));
  s == 1 ? ( slider1 = v; sliderchange(slider1); ) :
  s == 2 ? ( slider2 = v; sliderchange(slider2); ) :
  s == 3 ? ( slider3 = v; sliderchange(slider3); ) :
  s == 4 ? ( slider4 = v; sliderchange(slider4); ) :
  s == 5 ? ( slider5 = v; sliderchange(slider5); ) :
  s == 6 ? ( slider6 = v; sliderchange(slider6); ) :
           ( slider7 = v; sliderchange(slider7); );
);

// What a cell says. Key text is the dim label, value text the bright one.
function ctl_key_text(i) (
  i == 1 ? ( #ctl_key = "CC"; ) :
  i == 2 ? ( #ctl_key = "CH"; ) :
  i == 3 ? ( #ctl_key = "WIN"; ) :
  i == 4 ? ( #ctl_key = "DOTS"; ) :
  i == 5 ? ( #ctl_key = "ROWS"; ) :
  i == 6 ? ( slider2 ? ( #ctl_key = "FROZEN"; ) : ( #ctl_key = "FREEZE"; ); ) :
           ( #ctl_key = "CLEAR"; );
);

function ctl_value_text(i) local(v) (
  v = ctl_get(i);
  i == 1 ? ( v == 0 ? ( #ctl_val = "all"; ) : ( sprintf(#ctl_val, "%d", v); ); ) :
  i == 2 ? ( v == 0 ? ( #ctl_val = "all"; ) : ( sprintf(#ctl_val, "%d", v); ); ) :
  i == 3 ? ( sprintf(#ctl_val, "%ds", v); ) :
  i == 4 ? ( v == 0 ? ( #ctl_val = "auto"; ) : v == 1 ? ( #ctl_val = "event"; ) : ( #ctl_val = "none"; ); ) :
  i == 5 ? ( v == 0 ? ( #ctl_val = "below"; ) : ( #ctl_val = "beside"; ); ) :
           ( #ctl_val = ""; );
);

// The widest text a cell can show, so the cells do not move while a value
// changes: measuring what is on screen would shift every cell to its right.
function ctl_value_widest(i) (
  i == 1 ? ( #ctl_val = "127"; ) :
  i == 2 ? ( #ctl_val = "all"; ) :
  i == 3 ? ( #ctl_val = "30s"; ) :
  i == 4 ? ( #ctl_val = "event"; ) :
  i == 5 ? ( #ctl_val = "beside"; ) :
           ( #ctl_val = ""; );
);

function ctl_item_text(i, v) (
  i == 1 ? ( v == 0 ? ( #ctl_item = "all"; ) : ( sprintf(#ctl_item, "%d", v); ); ) :
  i == 2 ? ( v == 0 ? ( #ctl_item = "all"; ) : ( sprintf(#ctl_item, "%d", v); ); ) :
  i == 3 ? ( sprintf(#ctl_item, "%d s", v); ) :
  i == 4 ? ( v == 0 ? ( #ctl_item = "auto (12 px)"; ) : v == 1 ? ( #ctl_item = "every point"; ) : ( #ctl_item = "none"; ); ) :
           ( v == 0 ? ( #ctl_item = "rows below"; ) : ( #ctl_item = "rows beside"; ); );
);

/**
 * Places the seven cells left to right and records their geometry
 *
 * Widths come from the widest text each cell can hold, so a value changing does
 * not move its neighbours. Two tiers: with the key labels, and without them.
 */
function layout_bar_cells() local(i, x, w, tw, th, left_end, right_group, bar_right) (
  // Pass one: how wide each cell has to be.
  i = 1;
  loop(7,
    ctl_key_text(i);
    #ctl_key_measure = #ctl_key;
    i == 6 ? ( #ctl_key_measure = "FROZEN"; );
    w = CTRL_CELL_PAD * 2;
    ctl_shows_key(i) ? (
      gfx_measurestr(#ctl_key_measure, tw, th);
      w += tw + 8;
    );
    ctl_value_widest(i);
    gfx_measurestr(#ctl_val, tw, th);
    w += tw;
    ctl_is_selector(i) ? ( w += 11; );   // the caret and its air
    mem[MEM_CTL_W + i] = max(w, 20);
    i += 1;
  );

  // Pass two: where they go. The five selectors start on the plot's left edge;
  // the two buttons sit flush with its right edge, so the bar spans exactly the
  // same vertical lines as the plot. When the window is too narrow for that, the
  // buttons follow the selectors instead of overlapping them -- the tier check
  // in calculate_bar_layout() has already made sure the packed total fits.
  x = PLOT_LEFT;
  i = 1;
  loop(5,
    mem[MEM_CTL_X + i] = x;
    x += mem[MEM_CTL_W + i] + CTRL_CELL_GAP;
    i += 1;
  );
  left_end = x - CTRL_CELL_GAP;                       // right edge of ROWS
  right_group = mem[MEM_CTL_W + 6] + CTRL_CELL_GAP + mem[MEM_CTL_W + 7];
  bar_right = gfx_w - PLOT_RIGHT;

  (bar_right - right_group >= left_end + CTRL_CELL_GAP) ? (
    mem[MEM_CTL_X + 6] = bar_right - right_group;
  ) : (
    mem[MEM_CTL_X + 6] = left_end + CTRL_CELL_GAP;
  );
  mem[MEM_CTL_X + 7] = mem[MEM_CTL_X + 6] + mem[MEM_CTL_W + 6] + CTRL_CELL_GAP;

  // What the tier check needs is the width the cells occupy when packed edge to
  // edge, not the span of the ones placed flush right: the second is fixed by the
  // window and would always look like a fit.
  g_bar_total = 0;
  i = 1;
  loop(7,
    g_bar_total += mem[MEM_CTL_W + i];
    i += 1;
  );
  g_bar_total += CTRL_CELL_GAP * 6;
);

function calculate_bar_layout() (
  gfx_setfont(1, "Arial", BAR_FONT);
  g_bar_has_labels = 1;
  layout_bar_cells();
  PLOT_LEFT + g_bar_total > gfx_w - PLOT_RIGHT ? (
    g_bar_has_labels = 0;
    layout_bar_cells();
  );
  gfx_setfont(1, "Arial", FONT_SIZE);
);

// Hit test written as a chain and not as a loop on purpose: loop() in EEL2 is
// not reentrant, and this one is called from inside the loop that draws the
// cells. A nested loop there does not fail loudly -- it corrupts the outer
// counter, so the cells are drawn in a random order and the rest of the frame
// never runs.
function ctl_hit_test(px, py) local(hit) (
  hit = 0;
  (py >= CTRL_BAR_TOP && py <= CTRL_BAR_TOP + CTRL_BAR_HEIGHT) ? (
    hit = (px >= mem[MEM_CTL_X + 7] && px <= mem[MEM_CTL_X + 7] + mem[MEM_CTL_W + 7]) ? 7 :
          (px >= mem[MEM_CTL_X + 6] && px <= mem[MEM_CTL_X + 6] + mem[MEM_CTL_W + 6]) ? 6 :
          (px >= mem[MEM_CTL_X + 5] && px <= mem[MEM_CTL_X + 5] + mem[MEM_CTL_W + 5]) ? 5 :
          (px >= mem[MEM_CTL_X + 4] && px <= mem[MEM_CTL_X + 4] + mem[MEM_CTL_W + 4]) ? 4 :
          (px >= mem[MEM_CTL_X + 3] && px <= mem[MEM_CTL_X + 3] + mem[MEM_CTL_W + 3]) ? 3 :
          (px >= mem[MEM_CTL_X + 2] && px <= mem[MEM_CTL_X + 2] + mem[MEM_CTL_W + 2]) ? 2 :
          (px >= mem[MEM_CTL_X + 1] && px <= mem[MEM_CTL_X + 1] + mem[MEM_CTL_W + 1]) ? 1 : 0;
  );
  hit;
);

// Opens the list of a selector, scrolled so that the current value is in the
// middle: with 128 controllers the list cannot start at the top every time.
function ctl_open_menu(i) local(cur) (
  g_menu_open = 0;
  ctl_is_selector(i) ? (
    g_menu_open = i;
    g_menu_count = ctl_max(i) - ctl_min(i) + 1;
    g_menu_rows = min(g_menu_count, CTRL_MENU_ROWS);
    g_menu_w = max(mem[MEM_CTL_W + i], 92);
    g_menu_x = mem[MEM_CTL_X + i];
    g_menu_y = CTRL_BAR_TOP + CTRL_BAR_HEIGHT + 3;
    cur = ctl_get(i) - ctl_min(i);
    g_menu_scroll = max(0, min(cur - floor(g_menu_rows / 2), g_menu_count - g_menu_rows));
  );
);

// Returns 1 when the press was inside the open list (and acted on it), so the
// caller knows the click was consumed even after the list has closed.
function ctl_menu_press(px, py) local(r, v, h, used) (
  used = 0;
  g_menu_open > 0 ? (
    h = g_menu_rows * CTRL_ITEM_HEIGHT + 4;
    (px >= g_menu_x && px <= g_menu_x + g_menu_w && py >= g_menu_y && py <= g_menu_y + h) ? (
      r = floor((py - g_menu_y - 2) / CTRL_ITEM_HEIGHT);
      v = ctl_min(g_menu_open) + g_menu_scroll + r;
      (r >= 0 && r < g_menu_rows && v <= ctl_max(g_menu_open)) ? ( ctl_set(g_menu_open, v); );
      used = 1;
    );
    g_menu_open = 0;
  );
  used;
);

// The wheel arrives in host units, not in notches: measured on Windows a single
// notch is 120, so stepping by the raw delta took the time window from 10 s to
// 30 s (its maximum) in one turn. One notch = one step, and a fast spin still
// moves several when the delta is a multiple of it.
function ctl_wheel_steps(delta) (
  (delta > 0) ? max(1, floor(delta / 120)) : -max(1, floor(-delta / 120));
);

/**
 * Turns the mouse into changes: click opens, wheel steps, right click resets
 *
 * Run before drawing, so the frame shows the state the pointer has just made.
 * mouse_x / mouse_y are canvas coordinates, and with every slider hidden the
 * canvas is the whole window: the bar's geometry is the drawing geometry.
 */
function ctl_handle_mouse() local(down, rdown, wd, used) (
  g_ctl_ready == 0 ? (
    g_wheel_last = mouse_wheel;
    g_mouse_down = mouse_cap & 1;
    g_mouse_right = mouse_cap & 2;
    g_ctl_ready = 1;
  );

  down = mouse_cap & 1;
  rdown = mouse_cap & 2;
  g_hover_cell = ctl_hit_test(mouse_x, mouse_y);

  wd = mouse_wheel - g_wheel_last;
  g_wheel_last = mouse_wheel;
  wd != 0 ? (
    g_menu_open > 0 ? (
      g_menu_scroll = max(0, min(g_menu_scroll - ctl_wheel_steps(wd), g_menu_count - g_menu_rows));
    ) : (
      g_hover_cell > 0 ? ( ctl_is_selector(g_hover_cell) ? ( ctl_set(g_hover_cell, ctl_get(g_hover_cell) + ctl_wheel_steps(wd)); ); );
    );
  );

  (down && !g_mouse_down) ? (
    used = ctl_menu_press(mouse_x, mouse_y);
    used == 0 ? (
      g_menu_open = 0;
      g_hover_cell > 0 ? (
        g_hover_cell == 6 ? ( ctl_set(6, 1 - slider2); ) :
        g_hover_cell == 7 ? ( slider4 = 1; sliderchange(slider4); ) :
                            ( ctl_open_menu(g_hover_cell); );
      );
    );
  );

  (rdown && !g_mouse_right) ? (
    g_hover_cell > 0 ? (
      g_hover_cell == 7 ? ( slider4 = 1; sliderchange(slider4); ) : ( ctl_set(g_hover_cell, ctl_default(g_hover_cell)); );
    );
  );

  g_mouse_down = down;
  g_mouse_right = rdown;
);

/**
 * Fills a cell body: a rectangle with its four corners cut away
 *
 * JSFX has nothing like a rounded rectangle, and at twenty-four pixels of height
 * a two-pixel chamfer is what the eye reads as a corner. The body is two
 * overlapping rectangles, which leaves the four corner pixels black; the border
 * closes them with one pixel on each diagonal.
 *
 * @param x left edge
 * @param y top edge
 * @param w width
 * @param h height
 */
function draw_cell_body(x, y, w, h) (
  gfx_rect(x + CTRL_CORNER, y, w - CTRL_CORNER * 2, h, 1);
  gfx_rect(x, y + CTRL_CORNER, w, h - CTRL_CORNER * 2, 1);
);

/**
 * Draws a cell border, following the cut corners of draw_cell_body()
 *
 * The caller sets the colour: the same function draws an idle cell, a hovered one
 * and an engaged button, and only the colour says which is which.
 */
function draw_cell_border(x, y, w, h) (
  gfx_rect(x + CTRL_CORNER, y, w - CTRL_CORNER * 2, 1, 1);
  gfx_rect(x + CTRL_CORNER, y + h - 1, w - CTRL_CORNER * 2, 1, 1);
  gfx_rect(x, y + CTRL_CORNER, 1, h - CTRL_CORNER * 2, 1);
  gfx_rect(x + w - 1, y + CTRL_CORNER, 1, h - CTRL_CORNER * 2, 1);
  gfx_rect(x + 1, y + 1, 1, 1, 1);
  gfx_rect(x + w - 2, y + 1, 1, 1, 1);
  gfx_rect(x + 1, y + h - 2, 1, 1, 1);
  gfx_rect(x + w - 2, y + h - 2, 1, 1, 1);
);

/**
 * Draws the bar: a band of cells where REAPER's sliders used to be
 */
function draw_control_bar() local(i, x, w, y, tx, tw, th, hovered, is_on) (
  gfx_setfont(1, "Arial", BAR_FONT);
  y = CTRL_BAR_TOP;

  // The band is the window's own black, not a lighter strip: the bar is then a
  // row of small cells floating on the same background as the plot's margins,
  // and only the cells carry an edge. There is no rule under the bar: the top
  // edge of the plot's frame, a few pixels below, is already that line.
  gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 1;
  gfx_rect(0, 0, gfx_w, y + CTRL_BAR_HEIGHT + 3, 1);

  i = 1;
  loop(7,
    x = mem[MEM_CTL_X + i];
    w = mem[MEM_CTL_W + i];
    hovered = (g_hover_cell == i) ? 1 : 0;
    is_on = (i == 6 && slider2) ? 1 : 0;

    // Flat cells: the pointer over one, an open list or an engaged button are
    // the only three things that change the fill, so "on" reads at a glance
    gfx_a = 1;
    is_on ? (
      gfx_r = 0.32; gfx_g = 0.21; gfx_b = 0.08;
    ) : (hovered || g_menu_open == i) ? (
      gfx_r = 0.16; gfx_g = 0.16; gfx_b = 0.18;
    ) : (
      gfx_r = 0.10; gfx_g = 0.10; gfx_b = 0.11;
    );
    draw_cell_body(x, y, w, CTRL_BAR_HEIGHT);

    // The border, and with it the corners: an engaged button turns amber
    // altogether, so "armed" is one colour and not two.
    is_on ? ( gfx_r = 0.95; gfx_g = 0.62; gfx_b = 0.18; )
          : (hovered || g_menu_open == i) ? ( gfx_r = 0.55; gfx_g = 0.55; gfx_b = 0.57; )
                                          : ( gfx_r = 0.22; gfx_g = 0.22; gfx_b = 0.24; );
    draw_cell_border(x, y, w, CTRL_BAR_HEIGHT);

    ctl_key_text(i);
    ctl_value_text(i);
    tx = x + CTRL_CELL_PAD;
    gfx_y = y + floor((CTRL_BAR_HEIGHT - BAR_FONT) / 2);
    ctl_shows_key(i) ? (
      gfx_measurestr(#ctl_key, tw, th);
      is_on ? ( gfx_r = 1.0; gfx_g = 0.72; gfx_b = 0.30; ) : ( gfx_r = 0.60; gfx_g = 0.60; gfx_b = 0.62; );
      gfx_a = 1;
      gfx_x = tx;
      gfx_drawstr(#ctl_key);
      tx += tw + 8;
    );

    is_on ? ( gfx_r = 1.0; gfx_g = 0.80; gfx_b = 0.40; ) : ( gfx_r = 0.94; gfx_g = 0.94; gfx_b = 0.95; );
    gfx_a = 1;
    // With the labels on, the value sits against the caret: a cell whose value
    // grows ("all" -> "127") then keeps its text where the eye left it, and the
    // air goes into the gap instead of trailing after the value. Without labels
    // the value IS the cell, so it stays on the left.
    g_bar_has_labels ? (
      gfx_measurestr(#ctl_val, tw, th);
      // 15 = the caret (11) plus four pixels of air: without it the value ends
      // where the triangle begins and the two read as one glyph.
      gfx_x = x + w - (ctl_is_selector(i) ? 15 : CTRL_CELL_PAD) - tw;
    ) : (
      gfx_x = tx;
    );
    gfx_drawstr(#ctl_val);

    // The caret is drawn, not typed: no font is guaranteed to have the glyph.
    // It brightens with its cell, because it is the part that promises a list.
    ctl_is_selector(i) ? (
      (hovered || g_menu_open == i) ? ( gfx_r = 0.80; gfx_g = 0.80; gfx_b = 0.84; )
                                    : ( gfx_r = 0.52; gfx_g = 0.52; gfx_b = 0.55; );
      gfx_a = 1;
      gfx_triangle(x + w - 11, y + floor(CTRL_BAR_HEIGHT / 2) - 2,
                   x + w - 5, y + floor(CTRL_BAR_HEIGHT / 2) - 2,
                   x + w - 8, y + floor(CTRL_BAR_HEIGHT / 2) + 2);
    );

    // No hairline between the selectors and the buttons: the buttons now sit
    // against the plot's right edge, so the width of the gap is the separator,
    // and a line next to the last cell only looked like part of that cell.

    i += 1;
  );
  gfx_setfont(1, "Arial", FONT_SIZE);
);

/**
 * Draws the open list, last, so it can overlap the plot
 */
function draw_control_menu() local(i, r, v, y, h, hovered, current, thumb, thumbnail, scroll_h) (
  g_menu_open > 0 ? (
    i = g_menu_open;
    h = g_menu_rows * CTRL_ITEM_HEIGHT + 4;
    gfx_setfont(1, "Arial", BAR_FONT);

    gfx_r = 0.04; gfx_g = 0.04; gfx_b = 0.05; gfx_a = 1;
    gfx_rect(g_menu_x + 2, g_menu_y + 2, g_menu_w, h, 1);
    gfx_r = 0.11; gfx_g = 0.11; gfx_b = 0.13; gfx_a = 1;
    gfx_rect(g_menu_x, g_menu_y, g_menu_w, h, 1);
    gfx_r = 0.42; gfx_g = 0.42; gfx_b = 0.45; gfx_a = 1;
    gfx_rect(g_menu_x, g_menu_y, g_menu_w, h, 0);

    r = 0;
    loop(g_menu_rows,
      v = ctl_min(i) + g_menu_scroll + r;
      v <= ctl_max(i) ? (
        y = g_menu_y + 2 + r * CTRL_ITEM_HEIGHT;
        hovered = (mouse_x >= g_menu_x && mouse_x <= g_menu_x + g_menu_w
                   && mouse_y >= y && mouse_y < y + CTRL_ITEM_HEIGHT) ? 1 : 0;
        hovered ? (
          gfx_r = 0.20; gfx_g = 0.20; gfx_b = 0.24; gfx_a = 1;
          gfx_rect(g_menu_x + 1, y, g_menu_w - 2, CTRL_ITEM_HEIGHT, 1);
        );
        ctl_item_text(i, v);
        current = (v == ctl_get(i)) ? 1 : 0;
        current ? ( gfx_r = 1.0; gfx_g = 0.76; gfx_b = 0.36; ) : ( gfx_r = 0.78; gfx_g = 0.78; gfx_b = 0.80; );
        gfx_a = 1;
        gfx_x = g_menu_x + 10;
        gfx_y = y + floor((CTRL_ITEM_HEIGHT - BAR_FONT) / 2);
        gfx_drawstr(#ctl_item);
      );
      r += 1;
    );

    // With 128 controllers the list is longer than it is tall: a thin track and
    // a thumb say that there is more of it, which a clipped list does not.
    (g_menu_count > g_menu_rows) ? (
      scroll_h = h - 6;
      gfx_r = 0.22; gfx_g = 0.22; gfx_b = 0.25; gfx_a = 1;
      gfx_rect(g_menu_x + g_menu_w - 4, g_menu_y + 3, 2, scroll_h, 1);
      thumbnail = max(floor(scroll_h * g_menu_rows / g_menu_count), 8);
      thumb = floor((scroll_h - thumbnail) * g_menu_scroll / max(g_menu_count - g_menu_rows, 1));
      gfx_r = 0.50; gfx_g = 0.50; gfx_b = 0.54;
      gfx_rect(g_menu_x + g_menu_w - 4, g_menu_y + 3 + thumb, 2, thumbnail, 1);
    );
    gfx_setfont(1, "Arial", FONT_SIZE);
  );
);
