// ===================================================================
// MIDI CC UTILITIES LIBRARY - MULTI-CHANNEL SUPPORT
// ===================================================================
// Utility functions for MIDI CC visualization with channel awareness
// This is a library file (.jsfx-inc) to be imported by JSFX plugins
//
// PROVIDES:
// - Color palette management (six 16-color palettes)
// - Color assignment and retrieval for CC numbers (channel-independent)
// - History buffer management (circular buffer with channel support)
// - (CC#, Channel) pair data management
// - Memory-safe data structures
//
// CHANGELOG (v0.6.2):
// - build_visible_cc_channel_pair_list() replaces
//   build_active_cc_channel_pair_list() + get_active_cc_channel_pair_by_cc()
//   + count_cc_channels(): the CC filter and the new channel filter are applied
//   once, while the list is built, so bars and graph cannot disagree
//
// CHANGELOG (v0.5.2):
// - Fixed: the (CC, channel) key is now dense, (cc << 4) | channel, so the
//   2048-slot value range is really enough (before, keys up to 32527 wrote
//   into the active-flag, colour, palette, history and metrics ranges)
// - Fixed: get_active_cc_channel_pair_by_cc() returned -1 unconditionally
//   (no early return in EEL2)
// - Fixed: is_cc_channel_active() could never return false
// - Sorted pair list sized for all 2048 pairs (it was 300 slots)
// - Removed the deprecated add_to_history() shim and the unused
//   MEM_CC_SORTED_BY_CC / MEM_PAIR_LIST_BY_CC_COUNT ranges
//
// CHANGELOG (v0.5):
// - Added multi-channel support for CC data storage
// - History buffer now stores: time, cc_num, channel, value (was 3 items)
// - New data structure: (CC#, Channel) pairs as primary key
// - Colors remain CC#-based (independent of channel)
// - Added sorting and filtering by channel
// - Added helper functions for active (CC#, Channel) pair management
//
// USAGE:
// import midi_cc_utils.jsfx-inc
// ===================================================================

@init

// ========== MEMORY LAYOUT CONSTANTS ==========
// One flat mem[] space: every range must stay inside its declared size.
// CC values are indexed with a DENSE key, key = (cc_num << 4) | channel, so
// 128 CCs * 16 channels = 2048 slots are exactly enough (0..2047).
// The ranges below must not overlap: tools/check_ccscope_memory.py verifies it.
// The metrics range (ccscope_metrics.jsfx-inc) starts at 30000.
MEM_CC_VALUES = 0;            // 0..2047    CC value per (CC#, channel), key = (cc<<4)|channel
MEM_CC_ACTIVE = 2048;         // 2048..2175 active flag per CC# (any channel)
MEM_CC_CHANNEL_ACTIVE = 2176; // 2176..2303 bitmask of active channels per CC#
MEM_CC_SORTED = 2304;         // 2304..4351 sorted (CC#, channel) pair list, one slot per pair
MEM_COLOR_PALETTE = 4480;     // 4480..4527 RGB triplets, COLOR_PALETTE_SIZE * 3
MEM_HISTORY_BASE = 4608;      // 4608..12607 history buffer, 4 slots per entry
MEM_HISTORY_WRITE = 12608;    // write position pointer
MEM_HISTORY_COUNT = 12609;    // item count
MEM_PAIR_LIST_COUNT = 12611;  // count of active (CC#, channel) pairs

// The control-bar module owns a block of its own: geometry, values and pointer
// state of the cells and of the open list. Its internal layout is declared in
// ccscope_controlbar.jsfx-inc (the CBM_* constants); only the size lives here,
// because the address space has one owner and one checker.
MEM_CBM_BASE = 12612;         // 12612..12733 control-bar module block
MEM_CBM_SIZE = 122;

// The rows the control bar's menus offer, where a menu is not a range. One list
// lives here today: the time window, offered as 1, 2, 5, 10, 20, 30 seconds.
// The parameter keeps its 1..30 domain, so presets and automation are untouched;
// only the menu is shorter, and a value it does not offer still reads correctly.
MEM_WIN_LIST = 12734;         // 12734..12739 the WIN cell's list values
MEM_WIN_LIST_SIZE = 6;

// The temporal ring is the only large range, and it starts high so the small
// per-key ranges above stay readable as a block: 0..12739 is everything that is
// indexed by CC, channel or cell, and 3120000 is the ring behind it.

// The event ring keeps every CC event, not a per-pair bucket aggregate: one
// event is two slots (its timestamp, and pair * 128 + value -- at most 262143,
// exact in a double), and the ring is global, shared by all pairs, so its size
// buys history instead of dividing 2048 ways. Capacity is what the old bucketed
// ring cost, unchanged in bytes: 2600000 events * 2 = 5200000 slots, ending at
// 8320000, below JSFX's 8M-slot default. Reading is a walk from the newest event
// backwards until the window starts; nothing indexes a pair into the ring.
MEM_EVENT_RING = 3120000;     // 3120000..8320000 events, 2 slots each
EVENT_CAPACITY = 2600000;     // events held; older ones are overwritten
MEM_EVENT_COUNT = 12740;      // events written; the slot is count % EVENT_CAPACITY
MIN_EVENT_HISTORY_SECONDS = 30;  // the ring must cover the longest window...
EVENT_FLOOD_HZ = 1000;        // ...even at this many messages per second

// Per-pair drawing state for one frame, and the pair -> visible-slot map pass 1
// builds. Sized for every possible pair, so no draw can index a missing slot.
// Five slots per pair: a seen flag, the events met (for the stride), the last
// dot x, and the previous vertex.
// They sit in the gap between the small per-key ranges and the metrics block,
// which starts at 30000: 12741 + 5*2048 + 2048 + 2048 - 1 = 27076 < 30000.
MEM_PLOT_STATE = 12741;       // 12741..22980 prev x/y, dot x, seen, stride counter
MEM_PLOT_COUNT = 22981;       // 22981..25028 events in the window, per visible slot
MEM_PLOT_SLOT = 25029;        // 25029..27076 pair key -> visible slot, -1 = not visible
PLOT_STATE_STRIDE = 5;

// The measured drawing budget, not a setting (see ccscope_plot: ~1.4 us a point,
// so this is about 5.5 ms of a frame and leaves the rest of the UI its time).
MARK_BUDGET = 4000;
g_marks_drawn = 0;
g_events_drawn = 0;

/**
 * Appends one CC event to the shared ring. Two slots: the timestamp, and the
 * pair key packed with the value so a reader needs no second lookup.
 */
function add_event(timestamp, pair, value) local(count, slot) (
  count = mem[MEM_EVENT_COUNT];
  slot = MEM_EVENT_RING + (count % EVENT_CAPACITY) * 2;
  mem[slot] = timestamp;
  mem[slot + 1] = value + pair * 128;
  count < EVENT_CAPACITY ? mem[MEM_EVENT_COUNT] = count + 1;
);

/** Events currently readable: the ring holds the newest EVENT_CAPACITY. */
function event_count() (
  mem[MEM_EVENT_COUNT] < EVENT_CAPACITY ? mem[MEM_EVENT_COUNT] : EVENT_CAPACITY
);

/** Slot of event number `e`, where e counts from the oldest readable event. */
function event_slot(e) (
  MEM_EVENT_RING + (e % EVENT_CAPACITY) * 2
);

// ========== CONFIGURATION ==========
MAX_HISTORY_ITEMS = 2000;    // Maximum history buffer size
COLOR_PALETTE_SIZE = 16;     // Number of colors in palette
MAX_CC_CHANNEL_PAIRS = 2048; // Max (CC#, Channel) pairs (128 CCs × 16 channels = 2048)

// ========== COLOR PALETTE INITIALIZATION ==========
function set_palette_color(idx, rgb) local(base) (
  base = MEM_COLOR_PALETTE + idx * 3;
  mem[base] = floor(rgb / 65536) / 255;
  mem[base + 1] = (floor(rgb / 256) % 256) / 255;
  mem[base + 2] = (rgb % 256) / 255;
);

function init_color_palette(palette) (
  palette == 0 ? (
    set_palette_color(0, 0xff4545);
    set_palette_color(1, 0xf159e7);
    set_palette_color(2, 0x399dff);
    set_palette_color(3, 0x5592ff);
    set_palette_color(4, 0xffffff);
    set_palette_color(5, 0x27dfe8);
    set_palette_color(6, 0x35e65b);
    set_palette_color(7, 0xff9636);
    set_palette_color(8, 0xa6ed3b);
    set_palette_color(9, 0xbb79ff);
    set_palette_color(10, 0xffe23b);
    set_palette_color(11, 0xff80b3);
    set_palette_color(12, 0x39d6a0);
    set_palette_color(13, 0xff7661);
    set_palette_color(14, 0xd1ab47);
    set_palette_color(15, 0xbed2eb);
  ) :
  palette == 1 ? (
    set_palette_color(0, 0xe77878);
    set_palette_color(1, 0xc88bc2);
    set_palette_color(2, 0x83bce5);
    set_palette_color(3, 0x83a8e6);
    set_palette_color(4, 0xdedede);
    set_palette_color(5, 0x72c5c9);
    set_palette_color(6, 0x78c88b);
    set_palette_color(7, 0xdfa171);
    set_palette_color(8, 0xb4cb80);
    set_palette_color(9, 0xae94d6);
    set_palette_color(10, 0xdfc970);
    set_palette_color(11, 0xdc9fba);
    set_palette_color(12, 0x83c5ac);
    set_palette_color(13, 0xd49788);
    set_palette_color(14, 0xcbb088);
    set_palette_color(15, 0xadbacb);
  ) :
  palette == 2 ? (
    set_palette_color(0, 0xff5555);
    set_palette_color(1, 0x55e67a);
    set_palette_color(2, 0x638aff);
    set_palette_color(3, 0xffe45c);
    set_palette_color(4, 0x43e5ef);
    set_palette_color(5, 0xf276ed);
    set_palette_color(6, 0xff9b38);
    set_palette_color(7, 0xa7ed42);
    set_palette_color(8, 0xb384ff);
    set_palette_color(9, 0xff8fb4);
    set_palette_color(10, 0x46e6a8);
    set_palette_color(11, 0xff785b);
    set_palette_color(12, 0x75bbff);
    set_palette_color(13, 0xd6b53f);
    set_palette_color(14, 0x59c8c2);
    set_palette_color(15, 0xe2a0ff);
  ) :
  palette == 3 ? (
    set_palette_color(0, 0xff648a);
    set_palette_color(1, 0x64ff9c);
    set_palette_color(2, 0x7895ff);
    set_palette_color(3, 0xf9ef66);
    set_palette_color(4, 0x64e8ff);
    set_palette_color(5, 0xfb79ff);
    set_palette_color(6, 0xffac65);
    set_palette_color(7, 0xc1fa72);
    set_palette_color(8, 0xc699ff);
    set_palette_color(9, 0xff9acc);
    set_palette_color(10, 0x65f2c6);
    set_palette_color(11, 0xff8580);
    set_palette_color(12, 0x91c5ff);
    set_palette_color(13, 0xf2cb68);
    set_palette_color(14, 0x76ded8);
    set_palette_color(15, 0xdfadff);
  ) :
  palette == 4 ? (
    set_palette_color(0, 0xe69f00);
    set_palette_color(1, 0x56b4e9);
    set_palette_color(2, 0x009e73);
    set_palette_color(3, 0xf0e442);
    set_palette_color(4, 0x0072b2);
    set_palette_color(5, 0xd55e00);
    set_palette_color(6, 0xcc79a7);
    set_palette_color(7, 0xb9b9b9);
    set_palette_color(8, 0xffbd55);
    set_palette_color(9, 0x8bd3ff);
    set_palette_color(10, 0x5ac6a3);
    set_palette_color(11, 0xfff18a);
    set_palette_color(12, 0x6ea4d1);
    set_palette_color(13, 0xf58f66);
    set_palette_color(14, 0xe7a6cf);
    set_palette_color(15, 0xdddddd);
  ) :
  (
    set_palette_color(0, 0xd6a85b);
    set_palette_color(1, 0x80b9d4);
    set_palette_color(2, 0x75b69d);
    set_palette_color(3, 0xd6cc84);
    set_palette_color(4, 0x7f9fc1);
    set_palette_color(5, 0xce8f72);
    set_palette_color(6, 0xbe94ac);
    set_palette_color(7, 0xa5aaa9);
    set_palette_color(8, 0xe6c18b);
    set_palette_color(9, 0xacd0e1);
    set_palette_color(10, 0xa0d2bd);
    set_palette_color(11, 0xe7dfac);
    set_palette_color(12, 0xa9bdd1);
    set_palette_color(13, 0xdfb19a);
    set_palette_color(14, 0xd8b9c9);
    set_palette_color(15, 0xc6ccca);
  );
);

// Sets gfx color for a (CC#, Channel) pair. The hue belongs to the CC number
// and the channel only changes the shade, so two channels of the same CC are
// one colour family, not two unrelated colours:
//   channel 0/4/8/12  base
//   channel 1/5/9/13  darker
//   channel 2/6/10/14 lighter (towards white)
//   channel 3/7/11/15 muted  (towards grey)
function get_cc_channel_color(cc_num, channel) local(idx, base, v, r, g, b) (
  // Add 15 before modulo so CC 0 maps to slot 15 even in EEL2.
  idx = (cc_num + 15) % COLOR_PALETTE_SIZE;

  base = MEM_COLOR_PALETTE + (idx * 3);
  r = mem[base];
  g = mem[base + 1];
  b = mem[base + 2];

  v = channel % 4;
  v == 1 ? (
    r *= 0.55; g *= 0.55; b *= 0.55;
  ) : v == 2 ? (
    r = r * 0.45 + 0.55; g = g * 0.45 + 0.55; b = b * 0.45 + 0.55;
  ) : v == 3 ? (
    r = r * 0.60 + 0.28; g = g * 0.60 + 0.28; b = b * 0.60 + 0.28;
  );

  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = 1;
);

// Clears the stored value of every (CC#, channel) pair, keeping the pairs
// themselves: the bars stay where they are and drop to zero.
function clear_all_cc_values() local(i) (
  i = 0;
  loop(MAX_CC_CHANNEL_PAIRS,
    mem[MEM_CC_VALUES + i] = 0;
    i += 1;
  );
);

// ========== CC DATA MANAGEMENT (WITH CHANNEL SUPPORT) ==========

/**
 * Creates a unique key from CC number and channel
 *
 * Format: (cc_num << 4) | channel  -- the DENSE encoding: 128 CCs * 16
 * channels = 2048 keys (0..2047), which is exactly the size of the
 * MEM_CC_VALUES range. Widening the shift means resizing that range.
 *
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15, where 0=channel 1, 15=channel 16)
 * @return Unique integer key, 0..2047
 */
function make_cc_channel_key(cc_num, channel) (
  (cc_num << 4) | channel
);

/**
 * Extracts the CC number from a combined (CC, channel) key
 * @param key Combined key from make_cc_channel_key()
 * @return CC number (0-127)
 */
function key_to_cc(key) (
  (key >> 4) & 0x7F
);

/**
 * Extracts the channel from a combined (CC, channel) key
 * @param key Combined key from make_cc_channel_key()
 * @return MIDI channel (0-15, where 0=channel 1, 15=channel 16)
 */
function key_to_channel(key) (
  key & 0x0F
);

/**
 * Stores a CC value for a specific (CC#, Channel) pair
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15, where 0=channel 1, 15=channel 16)
 * @param cc_value CC value (0-127)
 */
function store_cc_channel_value(cc_num, channel, cc_value) local(key) (
  key = make_cc_channel_key(cc_num, channel);
  mem[MEM_CC_VALUES + key] = cc_value;
  mem[MEM_CC_ACTIVE + cc_num] = 1;  // Mark CC# as active
  
  // Mark this channel as active for this CC#
  mem[MEM_CC_CHANNEL_ACTIVE + cc_num] = mem[MEM_CC_CHANNEL_ACTIVE + cc_num] | (1 << channel);
);

/**
 * Retrieves a CC value for a specific (CC#, Channel) pair
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15)
 * @return CC value (0-127) or 0 if not set
 */
function get_cc_channel_value(cc_num, channel) local(key) (
  key = make_cc_channel_key(cc_num, channel);
  mem[MEM_CC_VALUES + key]
);

// Checks if a CC number has been received (on any channel)
function is_cc_active(cc_num) (
  mem[MEM_CC_ACTIVE + cc_num]
);

/**
 * Builds the list of (CC#, Channel) pairs that are both ACTIVE and VISIBLE.
 *
 * The filters are applied HERE, while the list is built: the CC filter
 * (cc_filter) and the channel filter (channel_filter) produce one list, and
 * every later stage -- bars, graph, layout, status line -- walks that same
 * list. Nothing downstream can then disagree about what is visible; the 0.5.2
 * bug, where the bars ignored the CC filter, was a second list implied by a
 * second code path.
 *
 * Pairs are sorted by CC# first, then by channel. The result goes to
 * MEM_CC_SORTED, the count to MEM_PAIR_LIST_COUNT.
 *
 * @param cc_filter CC number to keep (0-127), 0 = every CC
 * @param channel_filter MIDI channel to keep (1-16, as shown in the sliders),
 *                       0 = every channel
 * @return Number of visible (CC#, Channel) pairs, 0 if the filters match nothing
 */
function build_visible_cc_channel_pair_list(cc_filter, channel_filter) local(count, cc, channel, channel_mask)
(
  count = 0;
  
  cc = 0;
  loop(128,
    mem[MEM_CC_ACTIVE + cc] == 1 && (cc_filter == 0 || cc == cc_filter) ? (
      // This CC# is active and passes the filter, check which channels
      channel_mask = mem[MEM_CC_CHANNEL_ACTIVE + cc];
      
      channel = 0;
      loop(16,
        // channel is 0-15, the slider says 1-16
        (channel_mask & (1 << channel)) != 0 && (channel_filter == 0 || channel == channel_filter - 1) ? (
          // This channel is active for this CC# and passes the filter
          mem[MEM_CC_SORTED + count] = make_cc_channel_key(cc, channel);
          count += 1;
        );
        channel += 1;
      );
    );
    cc += 1;
  );
  
  mem[MEM_PAIR_LIST_COUNT] = count;
  count
);

/**
 * Gets the index-th pair of the list built by build_visible_cc_channel_pair_list()
 *
 * The bars and the graph both walk the visible list through here, so they draw
 * the same set by construction -- the filters are already applied upstream.
 *
 * @param index 0-based index into the visible list
 * @return Combined key (CC#, Channel) or -1 if the index is past the end
 */
function get_visible_cc_channel_pair(index) local(count) (
  count = mem[MEM_PAIR_LIST_COUNT];
  index >= count ? -1 : mem[MEM_CC_SORTED + index]
);



/**
 * Adds a data point to the history buffer with channel info
 * @param timestamp Time value (seconds)
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15)
 * @param cc_value CC value (0-127)
 */
function add_to_history_with_channel(timestamp, cc_num, channel, cc_value) local(pos, base) 
(
  pos = mem[MEM_HISTORY_WRITE];  // Current write position
  base = MEM_HISTORY_BASE + (pos * 4);  // 4 items per entry now
  
  // Store the quadruplet
  mem[base] = timestamp;
  mem[base + 1] = cc_num;
  mem[base + 2] = channel;
  mem[base + 3] = cc_value;
  
  // Update write position (circular buffer)
  mem[MEM_HISTORY_WRITE] = (pos + 1) % MAX_HISTORY_ITEMS;
  
  // Update count (max at MAX_HISTORY_ITEMS)
  mem[MEM_HISTORY_COUNT] = min(mem[MEM_HISTORY_COUNT] + 1, MAX_HISTORY_ITEMS);
);


// ========== HISTORY BUFFER MANAGEMENT (WITH CHANNEL SUPPORT) ==========
// Circular buffer that stores [timestamp, cc_num, channel, cc_value] quadruplets
// Automatically overwrites oldest data when full



// Returns the current number of items in history
function get_history_count() (
  mem[MEM_HISTORY_COUNT]
);

// Clears the history buffer
function clear_history() (
  // Clearing is O(1): the ring keeps its bytes, the count says none of them are
  // readable, and the next event overwrites the oldest slot. Nothing walks 5.2 M
  // slots from the GUI thread.
  mem[MEM_EVENT_COUNT] = 0;
  mem[MEM_HISTORY_WRITE] = 0;
  mem[MEM_HISTORY_COUNT] = 0;
);

// ========== INITIALIZATION ==========
function init_cc_utils() local(i) (
  // Initialize CC values
  i = 0;
  loop(MAX_CC_CHANNEL_PAIRS,
    mem[MEM_CC_VALUES + i] = 0;
    i += 1;
  );
  
  // Initialize CC active flags
  i = 0;
  loop(128,
    mem[MEM_CC_ACTIVE + i] = 0;
    mem[MEM_CC_CHANNEL_ACTIVE + i] = 0;  // Bit array for channel flags
    i += 1;
  );
  
  // Initialize history pointers
  mem[MEM_HISTORY_WRITE] = 0;
  mem[MEM_HISTORY_COUNT] = 0;
  mem[MEM_PAIR_LIST_COUNT] = 0;
  
  // Initialize color palette
  init_color_palette(0);
);

// ========== AUTO-INITIALIZATION ==========
// Automatically initialize when library is imported
init_cc_utils();
