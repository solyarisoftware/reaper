// ===================================================================
// CCSCOPE STATUS - the line under everything
// ===================================================================
// A library file (.jsfx-inc) imported by ccscope.jsfx.
//
// OWNS: one line of text at the bottom of the canvas. It says which flow the
// plugin is observing -- Waiting, Receiving, Idle, Frozen -- reports the recent
// activity of the selection (streams, channels, messages per second), keeps the
// warnings that say what does not fit, and carries the package version at the
// right edge. GitHub issue #17 defines the content; #22 will add the optional
// source label, which lives at the start of the line.
//
// ONE LINE, ALWAYS. A second line was implemented and measured in 0.10.0: it costs
// two rows of pairs on a 60-pair session, and its trigger -- the "showing N of M"
// warning -- makes the choice bistable around the row capacity, because the
// warning appears exactly when the shorter layout is in force. The measurement and
// the decision are recorded in CHANGELOG.md and issue #17.
//
// ORDER OF SACRIFICE on a narrow window: the version goes first, then the metric
// detail (channels, then streams). The two warnings of issue #17 §4 are never
// dropped.
//
// No other panel calls into this file and this file calls no other panel.
// ===================================================================

@init

// Measured widths, computed on the first frame (the font is set by the conductor
// before this file draws) and again only when the form or the text changes.
g_st_w = 0;          // width of the content, separators included
g_st_ver_w = 0;      // width of the version marker and its prefix
g_st_sep_w = 0;      // width of " · "
g_st_ready = 0;      // the three measurements above are valid
g_st_form = 3;       // metric detail: 3 = streams + channels + rate, 2 = no channels, 1 = rate
g_st_ver = 0;        // 1 when the version is drawn
g_st_y2 = 0;         // baseline of the line the eye sees
// The colour of the state word. Intensity says "is anything arriving?" before the
// word is read: dim when nothing ever arrived, grey when it did and went quiet,
// bright while it speaks, amber when acquisition is frozen. Colour stays redundant
// with the word, never the only carrier of a state.
g_st_head_r = 0.6;
g_st_head_g = 0.6;
g_st_head_b = 0.6;

// Pieces. A piece is drawn only when its flag says it exists: the fields are
// conditional, and an empty piece would otherwise leave a separator behind.
#st_head = "";
#st_streams = "";
#st_channels = "";
#st_rate = "";
#st_note = "";
#st_wv = "";
#st_ws = "";
#st_agg = "";
#st_sep = " · ";
#st_ver = "";

g_st_has_streams = 0;
g_st_has_channels = 0;
g_st_has_rate = 0;
g_st_has_note = 0;
g_st_has_wv = 0;
g_st_has_ws = 0;
  g_st_has_agg = 0;

// Fills the pieces for one state and one richness of metric detail. The caller
// measures them: this function draws nothing.
//
// The four states are derived, not stored: Frozen is the parameter, Waiting is
// "the selection holds no pair with data", Receiving is "some pair has a message
// in the rolling last second" (the summary's stream count), and Idle is the
// remainder -- data exists, nothing arrived in that second. Clear wipes the data,
// so after Clear the state is Waiting, not Idle: nothing has been received since.
function status_head_colour(count) (
  slider2 != 0 ? (
    g_st_head_r = 1.0; g_st_head_g = 0.6; g_st_head_b = 0.2;      // frozen: not a live reading
  ) : count == 0 ? (
    g_st_head_r = 0.45; g_st_head_g = 0.45; g_st_head_b = 0.45;   // waiting: never received
  ) : g_sel_streams == 0 ? (
    g_st_head_r = 0.6; g_st_head_g = 0.6; g_st_head_b = 0.6;      // idle: received, now silent
  ) : (
    g_st_head_r = 0.9; g_st_head_g = 0.9; g_st_head_b = 0.9;      // receiving: it speaks
  );
);

function status_build(count, form) (
  g_st_has_streams = 0;
  g_st_has_channels = 0;
  g_st_has_rate = 0;
  g_st_has_note = 0;

  slider2 != 0 ? (
    #st_head = "Frozen";
    #st_note = "acquisition paused; MIDI passes through";
    g_st_has_note = 1;
  ) : count == 0 ? (
    slider1 != 0 ? (
      slider6 != 0 ? (
        sprintf(#st_head, "Waiting for CC%02d/CH%02d", slider1, slider6);
      ) : (
        sprintf(#st_head, "Waiting for CC%02d", slider1);
      );
    ) : (
      slider6 != 0 ? (
        sprintf(#st_head, "Waiting for CH%02d", slider6);
      ) : (
        #st_head = "Waiting";
      );
    );
    #st_note = "no CC data yet";
    g_st_has_note = 1;
  ) : g_sel_streams == 0 ? (
    #st_head = "Idle";
    #st_note = "no matching CC in the last second";
    g_st_has_note = 1;
  ) : (
    #st_head = "Receiving";
    sprintf(#st_rate, "%d msg/s", g_sel_msg_s);
    g_st_has_rate = 1;

    form >= 2 ? (
      g_sel_streams == 1 ? (
        // One stream: name it instead of counting it. The name comes from
        // ccscope_cc_table.jsfx-inc and falls back to "CCnn", so this line never
        // says less than "1 stream" did.
        g_sel_one_key >= 0 ? (
          sprintf(#st_streams, "%s", cc_name_text(key_to_cc(g_sel_one_key)));
        ) : (
          #st_streams = "1 stream";
        );
      ) : (
        sprintf(#st_streams, "%d streams", g_sel_streams);
      );
      g_st_has_streams = 1;
    );

    form >= 3 ? (
      g_sel_channels == 1 ? (
        sprintf(#st_channels, "1 channel");
      ) : (
        sprintf(#st_channels, "%d channels", g_sel_channels);
      );
      g_st_has_channels = 1;
    );
  );

  // The two warnings of issue #17 §4: they are the reason the line exists, so
  // they are built for every state and never shortened away.
  g_st_has_wv = 0;
  g_st_has_ws = 0;
  count > g_visible_bars ? (
    sprintf(#st_wv, "showing %d of %d pairs (taller window fits more)", g_visible_bars, count);
    g_st_has_wv = 1;
  );
  g_side_fallback ? (
    #st_ws = "rows beside need a wider window";
    g_st_has_ws = 1;
  );

  // The step decimates above the measured drawing budget -- the marks never do --
  // so the line says it: a scope that silently drops what it draws is lying
  // about the stream exactly as a diagonal lies about the values in between.
  g_st_has_agg = 0;
  g_segment_stride > 1 ? (
    sprintf(#st_agg, "step every %d events (dense window)", g_segment_stride);
    g_st_has_agg = 1;
  );
);

// Sums the widths of the pieces that exist. One measure per piece: nothing is
// concatenated, so nothing can drift from what is drawn.
function status_measure() local(w, tw, th, first) (
  w = 0;
  first = 1;

  gfx_measurestr(#st_head, tw, th);
  w += tw;
  first = 0;
  g_st_has_note ? (
    w += first ? 0 : g_st_sep_w;
    gfx_measurestr(#st_note, tw, th);
    w += tw;
    first = 0;
  );
  g_st_has_streams ? (
    w += first ? 0 : g_st_sep_w;
    gfx_measurestr(#st_streams, tw, th);
    w += tw;
    first = 0;
  );
  g_st_has_channels ? (
    w += first ? 0 : g_st_sep_w;
    gfx_measurestr(#st_channels, tw, th);
    w += tw;
    first = 0;
  );
  g_st_has_rate ? (
    w += first ? 0 : g_st_sep_w;
    gfx_measurestr(#st_rate, tw, th);
    w += tw;
    first = 0;
  );
  g_st_has_wv ? (
    w += first ? 0 : g_st_sep_w;
    gfx_measurestr(#st_wv, tw, th);
    w += tw;
    first = 0;
  );
  g_st_has_ws ? (
    w += first ? 0 : g_st_sep_w;
    gfx_measurestr(#st_ws, tw, th);
    w += tw;
    first = 0;
  );
  g_st_has_agg ? (
    w += first ? 0 : g_st_sep_w;
    gfx_measurestr(#st_agg, tw, th);
    w += tw;
    first = 0;
  );

  w;
);

// Draws the line, separators included.
function status_draw(y) local(first) (
  gfx_x = 10;
  gfx_y = y;
  first = 1;

  gfx_r = g_st_head_r; gfx_g = g_st_head_g; gfx_b = g_st_head_b;
  gfx_a = 1;
  gfx_drawstr(#st_head);
  gfx_r = 0.6; gfx_g = 0.6; gfx_b = 0.6;
  first = 0;

  g_st_has_note ? ( !first ? ( gfx_drawstr(#st_sep); ); gfx_drawstr(#st_note); first = 0; );
  g_st_has_streams ? ( !first ? ( gfx_drawstr(#st_sep); ); gfx_drawstr(#st_streams); first = 0; );
  g_st_has_channels ? ( !first ? ( gfx_drawstr(#st_sep); ); gfx_drawstr(#st_channels); first = 0; );
  g_st_has_rate ? ( !first ? ( gfx_drawstr(#st_sep); ); gfx_drawstr(#st_rate); first = 0; );
  g_st_has_wv ? ( !first ? ( gfx_drawstr(#st_sep); ); gfx_drawstr(#st_wv); first = 0; );
  g_st_has_ws ? ( !first ? ( gfx_drawstr(#st_sep); ); gfx_drawstr(#st_ws); first = 0; );
  g_st_has_agg ? ( !first ? ( gfx_drawstr(#st_sep); ); gfx_drawstr(#st_agg); first = 0; );
  0;
);

// The version, flush with the right edge so it reads as provenance rather than as
// a field. The caller decides whether it fits.
function status_draw_version(y) (
  gfx_r = 0.45; gfx_g = 0.45; gfx_b = 0.45; gfx_a = 1;
  gfx_x = gfx_w - 10 - g_st_ver_w;
  gfx_y = y;
  gfx_drawstr("v");
  gfx_drawstr(#st_ver);
  0;
);

function draw_status_info(count) local(tw, th, avail) (
  !g_st_ready ? (
    gfx_measurestr(#st_sep, tw, th);
    g_st_sep_w = tw;
    strcpy(#st_ver, CCSCOPE_VERSION);
    gfx_measurestr("v", tw, th);
    g_st_ver_w = tw;
    gfx_measurestr(#st_ver, tw, th);
    g_st_ver_w += tw;
    g_st_ready = 1;
  );

  avail = gfx_w - 20;   // 10 px left margin, 10 px right margin
  g_st_ver = 0;
  g_st_y2 = gfx_h - STATUS_TEXT_MARGIN + 5;

  // The content must fit before anything else can be decided: it is the only part
  // that carries a warning.
  status_head_colour(count);
  status_build(count, 3);
  g_st_w = status_measure();
  g_st_form = 3;
  !(g_st_w <= avail) && g_st_has_rate ? (
    status_build(count, 2);
    g_st_w = status_measure();
    g_st_form = 2;
  );
  !(g_st_w <= avail) && g_st_has_rate ? (
    status_build(count, 1);
    g_st_w = status_measure();
    g_st_form = 1;
  );

  // Then the version, in whatever space is left: it is the first thing to go.
  g_st_w + g_st_ver_w + 8 <= avail ? ( g_st_ver = 1; );

  status_draw(g_st_y2);
  g_st_ver ? ( status_draw_version(g_st_y2); );
);
