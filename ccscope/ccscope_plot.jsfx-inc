// ===================================================================
// CCSCOPE PLOT - the scrolling trace, its frame, its time axis
// ===================================================================
// A library file (.jsfx-inc) imported by ccscope.jsfx.
//
// OWNS: the visible time window (calculate_time_window), the plot frame and the
// grid with its value labels, the offscreen image the static grid is cached into,
// the scrolling traces (one polyline per pair, in the pair order the layout
// decided) and the retained temporal points the DOTS slider selects.
//
// READS: the plot geometry (g_graph_*), the visible pair list, the raw history and
// the temporal buckets from ccscope_utils.jsfx-inc.
// WRITES: the g_time_* window variables and the cache state g_grid_cache_valid.
//
// No other panel calls into this file and this file calls no other panel.
// ===================================================================

@init

/**
 * Calculates the time window parameters in SECONDS
 * 
 * Sets:
 * - g_time_window: Duration of visible time window (seconds)
 * - g_time_start: Start time of visible window (seconds)
 * - g_time_end: End time of visible window (seconds)
 */
function calculate_time_window() local(current_time_sec) (
  // While frozen the window stops at the instant Freeze was engaged, so the
  // graph and the numbers describe the same moment.
  current_time_sec = g_prev_freeze ? g_freeze_time : g_clock_sec;
  
  g_time_window = slider3;
  g_time_end = current_time_sec;
  g_time_start = g_time_end - g_time_window;
);

/**
 * Draws the graph grid lines without background
 * 
 * Creates:
 * - Horizontal grid lines at CC values: 0, 32, 64, 96, 127
 * - Y-axis value labels on the left side
 * - Clean, minimal appearance without dark background
 */
function draw_graph_background() local(i, level, weight, y) (
  // The plot area is a very slightly lighter panel: it defines the drawing area
  // without a heavy frame, and the margins stay black
  gfx_r = 0.025; gfx_g = 0.025; gfx_b = 0.03; gfx_a = 1;
  gfx_rect(g_graph_margin_left, g_graph_start_y, g_graph_width, g_graph_actual_height, 1);

  // The frame is the scale: its top edge is 127, its bottom edge is 0. Drawing
  // two more lines on top of them would only double the border.
  gfx_r = 0.34; gfx_g = 0.34; gfx_b = 0.36; gfx_a = 1;
  gfx_rect(g_graph_margin_left, g_graph_start_y, g_graph_width, g_graph_actual_height, 0);

  // Interior guidance at the quarter points, dashed and unlabelled: they help
  // the eye estimate without competing with the bounds, which are the frame
  // itself. 64 is the centre and slightly brighter than 32 and 96.
  weight = 0;
  i = 0;
  loop(3,
    level = i == 0 ? 32 : i == 1 ? 64 : 96;
    y = g_graph_start_y + g_graph_actual_height
        - ((level - g_y_range_min) / g_y_range_total) * g_graph_actual_height;

    weight = level == 64 ? 0.30 : 0.24;
    gfx_r = weight; gfx_g = weight; gfx_b = weight + 0.02; gfx_a = 1;
    gfx_x = g_graph_margin_left;
    loop(floor(g_graph_width / 8),
      gfx_rect(gfx_x, y, 4, 1, 1);
      gfx_x += 8;
    );

    i += 1;
  );

  // Labels in the margin, right-aligned, digits padded. The two bounds are
  // kept inside the window: 127 sits just under the top edge, 0 just above the
  // bottom one, the centre on its line.
  gfx_setfont(1, "Arial", FONT_SIZE - 4);

  i = 0;
  loop(3,
    level = i == 0 ? 0 : i == 1 ? 64 : 127;
    y = g_graph_start_y + g_graph_actual_height
        - ((level - g_y_range_min) / g_y_range_total) * g_graph_actual_height;

    level == 127 ? ( y = g_graph_start_y + 1 ) :
    level == 0   ? ( y = g_graph_start_y + g_graph_actual_height - (FONT_SIZE - 4) - 1 ) :
                   ( y = y - (FONT_SIZE - 4) / 2 );

    gfx_r = level == 64 ? 0.45 : 0.58;
    gfx_g = level == 64 ? 0.45 : 0.58;
    gfx_b = level == 64 ? 0.48 : 0.60; gfx_a = 1;
    // No %3d padding: 127, 64 and 0 start on the same x as the CC rows, so the
    // whole left column hangs from a single vertical
    sprintf(#ylab, "%d", level);
    gfx_x = g_graph_margin_left - Y_LABEL_OFFSET;
    gfx_y = y;
    gfx_drawstr(#ylab);

    i += 1;
  );

  gfx_setfont(1, "Arial", FONT_SIZE);
);

/**
 * Draws vertical time grid lines and labels on X-axis
 * 
 * Creates tick marks every 1 second with time labels showing
 * seconds relative to the oldest visible point in the window
 */
function draw_time_grid() local(k, t, x_pos, tick_interval, label_interval, is_major, tw, th) (
  // A ruler: a faint line every second, a brighter one where there is a label.
  // Ticks are counted *backwards from now*, so the labels read exactly -5s, -10s
  // and stay aligned with the right edge while the window slides.
  tick_interval = 1;
  label_interval = slider3 <= 12 ? 1 : slider3 <= 24 ? 2 : 5;

  k = 0;
  loop(ceil(g_time_window / tick_interval) + 1,
    t = g_time_end - (k * tick_interval);

    t >= g_time_start ? (
      x_pos = g_graph_margin_left + ((t - g_time_start) / g_time_window) * g_graph_width;

      // The frame already draws both vertical edges, solid. A tick landing on
      // one would put dashes on top of the border: at "now" that reads as a
      // double line, one straight and one broken, where there is only one edge.
      x_pos > g_graph_margin_left && x_pos < g_graph_margin_left + g_graph_width - 1 ? (
        is_major = (k % label_interval) == 0;

        // Dashed like the horizontal guides, so the plot is one texture:
        // brighter where the label is, fainter in between
        is_major ? (
          gfx_r = 0.30; gfx_g = 0.30; gfx_b = 0.32;
        ) : (
          gfx_r = 0.20; gfx_g = 0.20; gfx_b = 0.22;
        );
        gfx_a = 1;
        gfx_y = g_graph_start_y;
        loop(ceil(g_graph_actual_height / 8),
          gfx_rect(x_pos, gfx_y, 1, 4, 1);
          gfx_y += 8;
        );

        // Labels on major ticks only, *outside* the plot like the value labels,
        // centred under their tick (a ruler, not a tick with a caption), and
        // never in the corner that belongs to "now"
        (is_major && k > 0 && x_pos < g_graph_margin_left + g_graph_width - 38) ? (
          gfx_setfont(1, "Arial", FONT_SIZE - 4);
          gfx_r = 0.52; gfx_g = 0.52; gfx_b = 0.54;
          sprintf(#tlab, "-%ds", k);
          gfx_measurestr(#tlab, tw, th);
          gfx_x = x_pos - (tw / 2);
          gfx_y = g_graph_start_y + g_graph_actual_height + TIME_LABEL_OFFSET;
          gfx_drawstr(#tlab);
        );
      );
    );

    k += 1;
  );

  // Right edge is the present: right-aligned on the border it names
  gfx_setfont(1, "Arial", FONT_SIZE - 4);
  gfx_r = 0.62; gfx_g = 0.62; gfx_b = 0.64;
  gfx_measurestr("now", tw, th);
  gfx_x = g_graph_margin_left + g_graph_width - (tw / 2);
  gfx_y = g_graph_start_y + g_graph_actual_height + TIME_LABEL_OFFSET;
  gfx_drawstr("now");
  gfx_setfont(1, "Arial", FONT_SIZE);
);

// The relative ruler and value grid do not move with the traces. Cache only
// this static layer; rows, controls and traces keep their normal draw order.
function draw_cached_graph_background() local(w, h, iw, ih, rebuild, top) (
  w = ceil(gfx_w);
  h = ceil(gfx_h);
  w > 0 && h > g_graph_start_y && w <= GRID_CACHE_MAX_DIM && h <= GRID_CACHE_MAX_DIM
    && g_graph_width > 0 && g_graph_actual_height >= 0 ? (
    gfx_getimgdim(GRID_CACHE_IMAGE, iw, ih);
    rebuild = !g_grid_cache_valid || iw != w || ih != h
      || g_grid_cache_w != w || g_grid_cache_h != h
      || g_grid_cache_left != g_graph_margin_left
      || g_grid_cache_top != g_graph_start_y
      || g_grid_cache_width != g_graph_width
      || g_grid_cache_height != g_graph_actual_height
      || g_grid_cache_window != g_time_window
      || g_grid_cache_font != FONT_SIZE
      || g_grid_cache_scale != gfx_ext_retina;
    rebuild ? (
      g_grid_cache_valid = 0;
      iw != w || ih != h ? gfx_setimgdim(GRID_CACHE_IMAGE, w, h);
      gfx_getimgdim(GRID_CACHE_IMAGE, iw, ih);
      iw == w && ih == h ? (
        gfx_dest = GRID_CACHE_IMAGE;
        gfx_mode = 0;
        gfx_r = 0; gfx_g = 0; gfx_b = 0; gfx_a = 1;
        gfx_rect(0, 0, w, h, 1);
        draw_graph_background();
        draw_time_grid();
        gfx_dest = -1;
        g_grid_cache_w = w;
        g_grid_cache_h = h;
        g_grid_cache_left = g_graph_margin_left;
        g_grid_cache_top = g_graph_start_y;
        g_grid_cache_width = g_graph_width;
        g_grid_cache_height = g_graph_actual_height;
        g_grid_cache_window = g_time_window;
        g_grid_cache_font = FONT_SIZE;
        g_grid_cache_scale = gfx_ext_retina;
        g_grid_cache_valid = 1;
      );
    );
    g_grid_cache_valid ? (
      // Do not overwrite the control bar already drawn above the plot. Copy
      // 1:1, ignoring image alpha and filtering, then restore normal drawing.
      top = max(0, floor(g_graph_start_y));
      gfx_a = 1;
      gfx_mode = 6;
      gfx_blit(GRID_CACHE_IMAGE, 1, 0, 0, top, w, h - top, 0, top, w, h - top);
      gfx_mode = 0;
    ) : (
      draw_graph_background();
      draw_time_grid();
    );
  ) : (
    g_grid_cache_valid = 0;
    draw_graph_background();
    draw_time_grid();
  );
);

// Draws the visible pairs from the event ring.
//
// What a CC is: piecewise constant. A message sets a value and the controller
// HOLDS it until the next message -- nothing travels in between. The trace is
// therefore a step, the previous value held horizontally up to the event and then
// a vertical to the new one, and never a diagonal: a 26-unit jump drawn as a ramp
// shows 25 values that were never on the wire. REAPER's own CC lanes are steps.
//
// Three passes. Pass 1 walks the ring backwards from the newest event and counts
// what the window holds per visible pair, remembering each pair's newest event
// index so its step is drawn even when the decimation skips it. Pass 2 walks
// forward and draws steps, marks and the held coda. Pass 3 releases the map.
//
// The marks are never decimated: a mark IS a received event, and a monitor that
// drops events silently is lying about the stream. What adapts to density is the
// primitive -- a filled circle (r=2) while successive marks of a pair stay
// MARK_CIRCLE_MIN px apart, a short vertical tick beyond it, where a row of
// circles would fuse into a band. The steps ARE decimated, above SEGMENT_BUDGET
// draw commands, because they are the expensive part; g_segment_stride says by
// how much and the status line repeats it.
//
// slider5 decides what is drawn around the events:
//   0  points + step + the dashed coda of the value still held (default)
//   1  points + step, the trace stopping on the last event
//   2  points only, no line at all
function draw_cc_data_lines(visible_count) local(
  i, pair, slot, state, e, n, idx, packed, t, v, x, y, cc, ch,
  oldest, seen_n, total, stride, cnt, px, py, seen, newest, done,
  x_right, last_x, last_y, dash_x, dash_end, dashes, k, dist) (

  g_marks_drawn = 0;
  g_events_in_window = 0;

  // pair -> visible slot for this frame only; per-pair state zeroed
  i = 0;
  loop(visible_count,
    pair = get_visible_cc_channel_pair(i);
    pair >= 0 ? (
      state = MEM_PLOT_STATE + pair * PLOT_STATE_STRIDE;
      mem[MEM_PLOT_SLOT + pair] = i;
      mem[MEM_PLOT_COUNT + i] = 0;
      mem[state] = 0;      // seen
      mem[state + 1] = 0;  // events met
      mem[state + 2] = 0;  // previous event x
      mem[state + 3] = 0;  // previous step x
      mem[state + 4] = 0;  // previous step y
      mem[state + 5] = -1; // newest event index
    );
    i += 1;
  );

  // ---- pass 1: how many events the window holds, and where it starts
  n = event_count();
  total = 0;
  oldest = -1;
  seen_n = 0;
  done = 0;
  while (seen_n < n && done == 0) (
    e = n - 1 - seen_n;
    idx = event_slot(e);
    t = mem[idx];
    t < g_time_start ? (
      done = 1;
    ) : (
      t <= g_time_end ? (
        pair = floor(mem[idx + 1] / 128);
        slot = mem[MEM_PLOT_SLOT + pair];
        slot >= 0 ? (
          // walking backwards, the first event met is the pair's newest
          mem[MEM_PLOT_COUNT + slot] == 0 ? (
            mem[MEM_PLOT_STATE + pair * PLOT_STATE_STRIDE + 5] = e;
          );
          mem[MEM_PLOT_COUNT + slot] += 1;
          total += 1;
        );
        oldest = e;
      );
      seen_n += 1;
    );
  );
  g_events_in_window = total;

  // ---- pass 2: draw. The window is every event from oldest to newest, so the
  // events of filtered-out pairs are walked and skipped here as they are in pass
  // 1: bounding the loop by the count of VISIBLE events would stop short of the
  // newest ones whenever the CC or channel filter hides events in between.
  stride = total * 2 <= SEGMENT_BUDGET ? 1 : ceil(total * 2 / SEGMENT_BUDGET);
  g_segment_stride = stride;
  e = oldest;
  while (e >= 0 && e < n) (
    idx = event_slot(e);
    packed = mem[idx + 1];
    pair = floor(packed / 128);
    slot = mem[MEM_PLOT_SLOT + pair];
    slot >= 0 ? (
      v = packed - pair * 128;
      t = mem[idx];
      state = MEM_PLOT_STATE + pair * PLOT_STATE_STRIDE;
      cnt = mem[state + 1];
      mem[state + 1] = cnt + 1;
      seen = mem[state];
      newest = mem[state + 5];
      px = mem[state + 3];
      py = mem[state + 4];
      cc = key_to_cc(pair);
      ch = key_to_channel(pair);
      x = g_graph_margin_left + (t - g_time_start) / g_time_window * g_graph_width;
      y = g_graph_start_y + g_graph_actual_height
        - (v - g_y_range_min) / g_y_range_total * g_graph_actual_height;
      get_cc_channel_color(cc, ch);

      // the trace: the previous value held up to this event, then the change.
      // The vertex moves only when a step is drawn, so a decimated step starts
      // where the previous DRAWN one ended and the trace stays unbroken.
      slider5 != 2 && seen != 0 && (x != px || y != py)
        && (cnt % stride == 0 || e == newest) ? (
        gfx_line(px, py, x, py);
        y != py ? gfx_line(x, py, x, y);
        mem[state + 3] = x;
        mem[state + 4] = y;
      );
      // the first event of a pair anchors the coda even when no step is drawn
      seen == 0 ? (
        mem[state + 3] = x;
        mem[state + 4] = y;
      );

      // the mark: one per event, never decimated
      dist = seen != 0 ? x - mem[state + 2] : MARK_CIRCLE_MIN;
      dist >= MARK_CIRCLE_MIN ? (
        gfx_circle(x, y, 2, 1);
      ) : (
        gfx_line(x, y - MARK_TICK_HALF, x, y + MARK_TICK_HALF);
      );
      g_marks_drawn += 1;

      mem[state] = 1;
      mem[state + 2] = x;
    );
    e += 1;
  );

  // ---- pass 3: the coda -- the value still held after the last event.
  // Between two events the trace is a measurement; after the last one it is an
  // inference, so it is dashed and can never be read as a segment between two
  // received events. It ends at g_time_end, which is the real instant or the
  // instant Freeze was engaged: the window already decides that, so this loop
  // never touches the clock.
  slider5 == 0 ? (
    x_right = g_graph_margin_left + g_graph_width;
    i = 0;
    loop(visible_count,
      pair = get_visible_cc_channel_pair(i);
      pair >= 0 ? (
        state = MEM_PLOT_STATE + pair * PLOT_STATE_STRIDE;
        mem[state] != 0 && mem[state + 3] < x_right ? (
          get_cc_channel_color(key_to_cc(pair), key_to_channel(pair));
          last_x = mem[state + 3];
          last_y = mem[state + 4];
          dashes = ceil((x_right - last_x) / (CODA_DASH_ON + CODA_DASH_OFF));
          k = 0;
          loop(dashes,
            dash_x = last_x + k * (CODA_DASH_ON + CODA_DASH_OFF);
            dash_end = min(dash_x + CODA_DASH_ON, x_right);
            dash_x < x_right ? gfx_line(dash_x, last_y, dash_end, last_y);
            k += 1;
          );
        );
      );
      i += 1;
    );
  );

  // release the map: a pair that leaves the selection must not keep a slot
  i = 0;
  loop(visible_count,
    pair = get_visible_cc_channel_pair(i);
    pair >= 0 ? mem[MEM_PLOT_SLOT + pair] = -1;
    i += 1;
  );
);
