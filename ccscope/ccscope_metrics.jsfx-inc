// ===================================================================
// MIDI CC METRICS LIBRARY - MULTI-CHANNEL SUPPORT
// ===================================================================
// Real-time performance metrics for MIDI Continuous Controller analysis
// Provides event rate, value change rate, and timing jitter calculations
// with full support for multi-channel MIDI data.
//
// METRICS EXPLAINED:
//
// 1. EVENTS PER SECOND (evt/s)
//    - Counts how many MIDI CC messages are received per second
//    - Example: 45 evt/s means 45 MIDI messages in the last second
//    - Includes repeated identical values; not a measure of value resolution
//    - Zero: no received messages, not evidence of physical stability
//
// 2. RATE (u/s - units per second)
//    - Measures how fast CC VALUES are changing (not timing)
//    - Calculated as: sum of |current_value - previous_value| per second
//    - Example: CC goes 60→65→70→75 in 1 sec = rate of 15 u/s
//    - Descriptive terms: slow <=15, moderate <=40, brisk <=70, fast >70
//    - MIDI value travel, not physical speed; noise and jumps also contribute
//
// 3. JITTER (milliseconds)
//    - Population standard deviation of accepted inter-message intervals
//    - Excludes intervals >4 times the shortest; needs >=4 accepted intervals
//    - Descriptive terms: steady <=5, even <=15, uneven <=30, loose <=50,
//      erratic >50 ms (unrounded values select the term)
//    - Not a guaranteed bound, latency estimate or hardware grade
//
// CHANGELOG (v0.5.2):
// - Removed the deprecated single-channel shims (update_metrics_for_cc,
//   get_events_per_second, get_rate_per_second, get_jitter_ms)
// - Fixed: the per-pair block was 600 slots for a layout that needs 602
//   (2 header slots + 200 events * 3). The 200th event of a pair overwrote
//   the event count and last value of the NEXT pair, so that pair stopped
//   recording and the pruning loop started walking other blocks' data.
//   CC_BLOCK_SIZE is now derived from the layout, not typed by hand.
//
// CHANGELOG (v0.5):
// - Added multi-channel metrics tracking
// - Each (CC#, Channel) pair maintains independent metrics
// - Memory layout updated to support 128 CCs × 16 channels
// - New functions for channel-aware metric retrieval
// - Pruning algorithm updated for channel-aware data
//
// TECHNICAL DETAILS:
// - All metrics calculated over a 1-second rolling window
// - Window slides continuously (not reset)
// - Old events automatically pruned when older than 1 second
// - Metrics update smoothly without flickering
// - Memory efficient: stores only last 1 second of events per (CC#, Channel) pair
//
// MEMORY LAYOUT (per CC per Channel):
// - Event buffer: stores timestamps and values for last 1 second
// - Each event: 3 floats (timestamp, value, delta)
// - 500 events per (CC#, Channel) pair, i.e. up to 500 evt/s. The buffer is
//   larger than the window needs at that rate on purpose: the window is
//   filtered on read (see g_metrics_now), so a buffer holding exactly one
//   second of events would under-report as soon as the prune runs late.
// ===================================================================

@init

// ========== CONFIGURATION ==========
METRICS_WINDOW_SEC = 1.0;      // Rolling window duration
MIN_JITTER_INTERVALS = 4;      // below this, jitter is reported as -1 (n/a)
GAP_FACTOR = 4;               // intervals greater than this times the shortest are gaps
MAX_EVENTS_PER_CC = 500;       // events held per (CC, channel); 500 evt/s at 1 s

// ========== MEMORY ALLOCATION ==========
// Memory layout: base = 30000 (avoid conflict with other modules)
// Supports 128 CCs × 16 channels = 2048 (CC#, Channel) pairs
// Each pair gets a dedicated memory block

metrics_base = 30000;

// Per-(CC#, Channel) memory structure, CC_BLOCK_SIZE slots:
// [0]: event_count (number of events in buffer)
// [1]: last_value (previous CC value for rate calculation)
// [2 .. 2 + MAX_EVENTS_PER_CC*3 - 1]: event buffer, 3 slots per event
//   Each event: [timestamp, value, delta]

// 1502 = two header slots plus the events. The block size follows from the
// layout above; typing a round number here is what corrupted the next pair's
// header on every 200th event (0.5.1). tools/check_ccscope_memory.py verifies it;
// the total extent is 30000 + 2048 * 1502 = 3,106,096 slots.
CC_BLOCK_SIZE = 2 + (MAX_EVENTS_PER_CC * 3);
CHANNELS_PER_CC = 16;

/**
 * Gets the memory address for a specific (CC#, Channel) pair's metrics block
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15)
 * @return Memory address of (CC#, Channel) metrics block
 */
function get_cc_channel_metrics_base(cc_num, channel) (
  metrics_base + (cc_num * CHANNELS_PER_CC + channel) * CC_BLOCK_SIZE
);

// "Now" for every window computation below. The caller sets it once per frame;
// the buffers are pruned every 100 ms, so counting what is *buffered* would
// count up to 1.1 s of events and overstate the rate by up to 10%.
g_metrics_now = 0;

/**
 * Initializes the metrics system
 * Clears all buffers and resets counters for all (CC#, Channel) pairs
 */
function init_metrics() local(cc, channel, block_idx) (
  block_idx = 0;
  cc = 0;
  loop(128,
    channel = 0;
    loop(16,
      mem[metrics_base + block_idx * CC_BLOCK_SIZE] = 0;      // Clear event count
      mem[metrics_base + block_idx * CC_BLOCK_SIZE + 1] = -1; // Mark as uninitialized
      block_idx += 1;
      channel += 1;
    );
    cc += 1;
  );
);

/**
 * Adds a new event to the metrics buffer for a (CC#, Channel) pair
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15)
 * @param value CC value (0-127)
 * @param time_sec Timestamp in seconds
 */
function update_metrics_for_cc_channel(cc_num, channel, value, time_sec) 
  local(base, count, last_val, delta, event_idx, event_ptr) (
  
  base = get_cc_channel_metrics_base(cc_num, channel);
  count = mem[base];
  last_val = mem[base + 1];
  
  // Calculate value delta (for rate calculation)
  delta = last_val >= 0 ? abs(value - last_val) : 0;
  
  // Store this value as last_value for next time
  mem[base + 1] = value;
  
  // Add event to buffer (if space available)
  count < MAX_EVENTS_PER_CC ? (
    event_idx = count;
    event_ptr = base + 2 + (event_idx * 3);
    
    mem[event_ptr] = time_sec;      // Timestamp
    mem[event_ptr + 1] = value;     // CC value
    mem[event_ptr + 2] = delta;     // Value change delta
    
    mem[base] = count + 1;          // Increment count
  );
);

/**
 * Removes events older than METRICS_WINDOW_SEC from all (CC#, Channel) buffers
 * @param current_time_sec Current time in seconds
 */
function prune_old_metrics(current_time_sec) 
  local(cc, channel, base, count, cutoff_time, src_idx, dst_idx, event_ptr, event_time, block_idx) (
  
  cutoff_time = current_time_sec - METRICS_WINDOW_SEC;
  block_idx = 0;
  
  cc = 0;
  loop(128,
    channel = 0;
    loop(16,
      base = metrics_base + block_idx * CC_BLOCK_SIZE;
      count = mem[base];
      
      count > 0 ? (
        dst_idx = 0;
        src_idx = 0;
        
        // Compact buffer: keep only recent events
        loop(count,
          event_ptr = base + 2 + (src_idx * 3);
          event_time = mem[event_ptr];
          
          // Keep this event if it's recent enough
          event_time >= cutoff_time ? (
            src_idx != dst_idx ? (
              // Copy event to new position
              mem[base + 2 + (dst_idx * 3)] = mem[event_ptr];
              mem[base + 2 + (dst_idx * 3) + 1] = mem[event_ptr + 1];
              mem[base + 2 + (dst_idx * 3) + 2] = mem[event_ptr + 2];
            );
            dst_idx += 1;
          );
          
          src_idx += 1;
        );
        
        // Update count
        mem[base] = dst_idx;
      );
      
      block_idx += 1;
      channel += 1;
    );
    cc += 1;
  );
);

/**
 * Calculates events per second for a (CC#, Channel) pair
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15)
 * @return Number of events in the last second
 */
function get_events_per_second_cc_channel(cc_num, channel)
  local(base, count, i, ptr, kept, cutoff) (

  base = get_cc_channel_metrics_base(cc_num, channel);
  count = mem[base];
  cutoff = g_metrics_now - METRICS_WINDOW_SEC;

  kept = 0;
  i = 0;
  loop(count,
    ptr = base + 2 + (i * 3);
    mem[ptr] >= cutoff ? kept += 1;
    i += 1;
  );

  kept
);

/**
 * Calculates rate (value change per second) for a (CC#, Channel) pair
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15)
 * @return Sum of absolute value changes per second
 */
function get_rate_per_second_cc_channel(cc_num, channel)
  local(base, count, total_delta, i, ptr, cutoff) (

  base = get_cc_channel_metrics_base(cc_num, channel);
  count = mem[base];
  cutoff = g_metrics_now - METRICS_WINDOW_SEC;

  total_delta = 0;
  i = 0;

  loop(count,
    ptr = base + 2 + (i * 3);
    mem[ptr] >= cutoff ? total_delta += mem[ptr + 2];
    i += 1;
  );

  total_delta
);

/**
 * Returns quality rating text for rate value
 * @param rate_value Rate in units per second
 * @return Descriptive string: "slow", "moderate", "brisk", or "fast"
 */
// Words for a musician, not for an engineer: this is how fast the gesture moves
function get_rate_quality(rate_value) (
  rate_value <= 15 ? "slow" :
  rate_value <= 40 ? "moderate" :
  rate_value <= 70 ? "brisk" :
  "fast"
);

/**
 * Calculates jitter (timing consistency) for a (CC#, Channel) pair
 * Returns standard deviation of time intervals between events
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15)
 * @return Jitter in milliseconds (standard deviation, not a bound)
 */
// Accepted interval count for the last valid reading; zero on n/a is a sentinel,
// not an actual accepted count. Capture immediately: the next pair overwrites it.
g_jitter_intervals = 0;

/**
 * Calculates jitter (timing consistency) for a (CC#, Channel) pair
 * Returns the standard deviation of the inter-arrival intervals in the window,
 * ignoring the gapped ones: an interval longer than GAP_FACTOR times the
 * shortest is a pause (or a loop jump, or a stale event), not jitter. Without
 * that filter a single gap would dominate the spacing variation.
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15)
 * @return Jitter in milliseconds, or -1 when the window has fewer than
 *         MIN_JITTER_INTERVALS usable intervals (valid-reading count in g_jitter_intervals)
 */
function get_jitter_ms_cc_channel(cc_num, channel)
  local(base, count, i, ptr, cutoff, prev_time, curr_time, interval, first_time,
        min_interval, limit, used, sum_intervals, mean_interval,
        sum_squared_diff, variance) (

  base = get_cc_channel_metrics_base(cc_num, channel);
  count = mem[base];
  cutoff = g_metrics_now - METRICS_WINDOW_SEC;
  g_jitter_intervals = 0;

  // pass 1: shortest interval in the window
  min_interval = 0;
  prev_time = 0;
  used = 0;
  i = 0;
  loop(count,
    ptr = base + 2 + (i * 3);
    mem[ptr] >= cutoff ? (
      used == 0 ? (
        prev_time = mem[ptr];
      ) : (
        interval = mem[ptr] - prev_time;
        (min_interval == 0 || interval < min_interval) ? min_interval = interval;
        prev_time = mem[ptr];
      );
      used += 1;
    );
    i += 1;
  );

  used < MIN_JITTER_INTERVALS + 1 ? ( -1 ) : (
    limit = min_interval * GAP_FACTOR;

    // pass 2: mean of the intervals that are not gaps
    sum_intervals = 0;
    used = 0;
    prev_time = 0;
    i = 0;
    loop(count,
      ptr = base + 2 + (i * 3);
      mem[ptr] >= cutoff ? (
        used == 0 ? (
          prev_time = mem[ptr];
          used = 1;
        ) : (
          interval = mem[ptr] - prev_time;
          prev_time = mem[ptr];
          interval <= limit ? (
            sum_intervals += interval;
            used += 1;
          );
        );
      );
      i += 1;
    );

    used < MIN_JITTER_INTERVALS + 1 ? ( -1 ) : (
      g_jitter_intervals = used - 1;
      mean_interval = sum_intervals / (used - 1);

      // pass 3: variance of the same intervals
      sum_squared_diff = 0;
      used = 0;
      prev_time = 0;
      i = 0;
      loop(count,
        ptr = base + 2 + (i * 3);
        mem[ptr] >= cutoff ? (
          used == 0 ? (
            prev_time = mem[ptr];
            used = 1;
          ) : (
            interval = mem[ptr] - prev_time;
            prev_time = mem[ptr];
            interval <= limit ? (
              sum_squared_diff += (interval - mean_interval) * (interval - mean_interval);
              used += 1;
            );
          );
        );
        i += 1;
      );

      variance = sum_squared_diff / (used - 1);
      sqrt(variance) * 1000
    );
  );
);

/**
 * Returns quality rating text for jitter value
 * @param jitter_ms Jitter in milliseconds
 * @return Descriptive string: "steady", "even", "uneven", "loose", or "erratic"
 */
// How much the spacing between messages wobbles
function get_jitter_quality(jitter_ms) (
  jitter_ms <= 5 ? "steady" :
  jitter_ms <= 15 ? "even" :
  jitter_ms <= 30 ? "uneven" :
  jitter_ms <= 50 ? "loose" :
  "erratic"
);

// Initialize metrics system
init_metrics();
