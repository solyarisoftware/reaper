// CCScope one-second metrics. Messages and Motion preserve their event/delta
// rules. Timing walks acquisition order over the closed [now-1, now] window.
// Negative timestamps and out-of-window events break adjacency. Zero is valid;
// a negative delta is skipped and its current endpoint starts the next interval.
// Raw intervals include zeros and all pauses; nearest-rank p50/p95 use sorted ms.
// At most 500 retained events / 499 intervals per pair. Capacity saturation can
// under-represent a faster stream; this is not a hardware or latency assessment.
// get_timing_cc_channel() publishes scalar outputs for immediate row capture.
// It recomputes once per drawn row/frame at g_metrics_now, never on hover. The
// shared scratch is GUI-only, bounded heapsort O(n log n), and never a snapshot.

@init

// ========== CONFIGURATION ==========
METRICS_WINDOW_SEC = 1.0;      // Rolling window duration
MIN_JITTER_INTERVALS = 4;      // below this, jitter is reported as -1 (n/a)
GAP_FACTOR = 4;               // intervals greater than this times the shortest are gaps
MAX_EVENTS_PER_CC = 500;       // events held per (CC, channel); 500 evt/s at 1 s

// ========== MEMORY ALLOCATION ==========
// Memory layout: base = 30000 (avoid conflict with other modules)
// Supports 128 CCs × 16 channels = 2048 (CC#, Channel) pairs
// Each pair gets a dedicated memory block

metrics_base = 30000;

// Per-(CC#, Channel) memory structure, CC_BLOCK_SIZE slots:
// [0]: event_count (number of events in buffer)
// [1]: last_value (previous CC value for rate calculation)
// [2 .. 2 + MAX_EVENTS_PER_CC*3 - 1]: event buffer, 3 slots per event
//   Each event: [timestamp, value, delta]

// 1502 = two header slots plus the events. The block size follows from the
// layout above; typing a round number here is what corrupted the next pair's
// header on every 200th event (0.5.1). tools/check_ccscope_memory.py verifies it;
// the total extent is 30000 + 2048 * 1502 = 3,106,096 slots.
CC_BLOCK_SIZE = 2 + (MAX_EVENTS_PER_CC * 3);
CHANNELS_PER_CC = 16;

/**
 * Gets the memory address for a specific (CC#, Channel) pair's metrics block
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15)
 * @return Memory address of (CC#, Channel) metrics block
 */
function get_cc_channel_metrics_base(cc_num, channel) (
  metrics_base + (cc_num * CHANNELS_PER_CC + channel) * CC_BLOCK_SIZE
);

// "Now" for every window computation below. The caller sets it once per frame;
// the buffers are pruned every 100 ms, so counting what is *buffered* would
// count up to 1.1 s of events and overstate the rate by up to 10%.
g_metrics_now = 0;

/**
 * Initializes the metrics system
 * Clears all buffers and resets counters for all (CC#, Channel) pairs
 */
function init_metrics() local(cc, channel, block_idx) (
  block_idx = 0;
  cc = 0;
  loop(128,
    channel = 0;
    loop(16,
      mem[metrics_base + block_idx * CC_BLOCK_SIZE] = 0;      // Clear event count
      mem[metrics_base + block_idx * CC_BLOCK_SIZE + 1] = -1; // Mark as uninitialized
      block_idx += 1;
      channel += 1;
    );
    cc += 1;
  );
);

/**
 * Adds a new event to the metrics buffer for a (CC#, Channel) pair
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15)
 * @param value CC value (0-127)
 * @param time_sec Timestamp in seconds
 */
function update_metrics_for_cc_channel(cc_num, channel, value, time_sec) 
  local(base, count, last_val, delta, event_idx, event_ptr) (
  
  base = get_cc_channel_metrics_base(cc_num, channel);
  count = mem[base];
  last_val = mem[base + 1];
  
  // Calculate value delta (for rate calculation)
  delta = last_val >= 0 ? abs(value - last_val) : 0;
  
  // Store this value as last_value for next time
  mem[base + 1] = value;
  
  // Add event to buffer (if space available)
  count < MAX_EVENTS_PER_CC ? (
    event_idx = count;
    event_ptr = base + 2 + (event_idx * 3);
    
    mem[event_ptr] = time_sec;      // Timestamp
    mem[event_ptr + 1] = value;     // CC value
    mem[event_ptr + 2] = delta;     // Value change delta
    
    mem[base] = count + 1;          // Increment count
  );
);

/**
 * Removes the expired prefix from all (CC#, Channel) buffers, preserving
 * interior separators if timestamps are non-monotonic
 * @param current_time_sec Current time in seconds
 */
function prune_old_metrics(current_time_sec) 
  local(cc, channel, base, count, cutoff_time, src_idx, dst_idx, event_ptr, event_time, block_idx, keep_started) (
  
  cutoff_time = current_time_sec - METRICS_WINDOW_SEC;
  block_idx = 0;
  
  cc = 0;
  loop(128,
    channel = 0;
    loop(16,
      base = metrics_base + block_idx * CC_BLOCK_SIZE;
      count = mem[base];
      
      count > 0 ? (
        dst_idx = 0;
        src_idx = 0;
        keep_started = 0;
        
        // Remove only the expired prefix. Retain later expired separators if
        // timestamps went backwards: compacting those would invent adjacency.
        loop(count,
          event_ptr = base + 2 + (src_idx * 3);
          event_time = mem[event_ptr];
          
          // Normal monotonic streams have the same retained events as before.
          event_time >= cutoff_time ? keep_started = 1;
          keep_started ? (
            src_idx != dst_idx ? (
              // Copy event to new position
              mem[base + 2 + (dst_idx * 3)] = mem[event_ptr];
              mem[base + 2 + (dst_idx * 3) + 1] = mem[event_ptr + 1];
              mem[base + 2 + (dst_idx * 3) + 2] = mem[event_ptr + 2];
            );
            dst_idx += 1;
          );
          
          src_idx += 1;
        );
        
        // Update count
        mem[base] = dst_idx;
      );
      
      block_idx += 1;
      channel += 1;
    );
    cc += 1;
  );
);

/**
 * Calculates events per second for a (CC#, Channel) pair
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15)
 * @return Number of events in the last second
 */
function get_events_per_second_cc_channel(cc_num, channel)
  local(base, count, i, ptr, kept, cutoff) (

  base = get_cc_channel_metrics_base(cc_num, channel);
  count = mem[base];
  cutoff = g_metrics_now - METRICS_WINDOW_SEC;

  kept = 0;
  i = 0;
  loop(count,
    ptr = base + 2 + (i * 3);
    mem[ptr] >= cutoff ? kept += 1;
    i += 1;
  );

  kept
);

/**
 * Calculates rate (value change per second) for a (CC#, Channel) pair
 * @param cc_num CC number (0-127)
 * @param channel MIDI channel (0-15)
 * @return Sum of absolute value changes per second
 */
function get_rate_per_second_cc_channel(cc_num, channel)
  local(base, count, total_delta, i, ptr, cutoff) (

  base = get_cc_channel_metrics_base(cc_num, channel);
  count = mem[base];
  cutoff = g_metrics_now - METRICS_WINDOW_SEC;

  total_delta = 0;
  i = 0;

  loop(count,
    ptr = base + 2 + (i * 3);
    mem[ptr] >= cutoff ? total_delta += mem[ptr + 2];
    i += 1;
  );

  total_delta
);

/**
 * Returns quality rating text for rate value
 * @param rate_value Rate in units per second
 * @return Descriptive string: "slow", "moderate", "brisk", or "fast"
 */
// Words for a musician, not for an engineer: this is how fast the gesture moves
function get_rate_quality(rate_value) (
  rate_value <= 15 ? "slow" :
  rate_value <= 40 ? "moderate" :
  rate_value <= 70 ? "brisk" :
  "fast"
);

// Shared scratch is reserved by utils and checked by check_ccscope_memory.py.
// In-place max-heap sift, inclusive end. No recursion or per-pair allocation.
function timing_sift_down(root, end) local(child, swap_value, running) (
  running = 1;
  while(running && root * 2 + 1 <= end) (
    child = root * 2 + 1;
    child < end && mem[MEM_TIMING_SCRATCH + child] < mem[MEM_TIMING_SCRATCH + child + 1]
      ? child += 1;
    mem[MEM_TIMING_SCRATCH + root] < mem[MEM_TIMING_SCRATCH + child] ? (
      swap_value = mem[MEM_TIMING_SCRATCH + root];
      mem[MEM_TIMING_SCRATCH + root] = mem[MEM_TIMING_SCRATCH + child];
      mem[MEM_TIMING_SCRATCH + child] = swap_value;
      root = child;
    ) : running = 0;
  );
);

function timing_sort(count) local(start, end, swap_value) (
  start = floor(count / 2) - 1;
  while(start >= 0) (timing_sift_down(start, count - 1); start -= 1;);
  end = count - 1;
  while(end > 0) (
    swap_value = mem[MEM_TIMING_SCRATCH];
    mem[MEM_TIMING_SCRATCH] = mem[MEM_TIMING_SCRATCH + end];
    mem[MEM_TIMING_SCRATCH + end] = swap_value;
    end -= 1;
    timing_sift_down(0, end);
  );
);

// All outputs reset even on n/a. Only count=0 is insufficient for raw stats;
// n=1 is allowed, with the count always exposed in the row and help.
g_timing_intervals = 0;
g_timing_p50 = -1; g_timing_p95 = -1;
g_timing_min = -1; g_timing_max = -1; g_timing_coincident = -1;
g_timing_jitter = -1; g_timing_jitter_intervals = 0;

function get_timing_cc_channel(cc_num, channel)
  local(base, count, cutoff, i, time, previous, have_previous, interval,
        zeros, used, sum, mean, squared, limit) (
  base = get_cc_channel_metrics_base(cc_num, channel);
  count = min(mem[base], MAX_EVENTS_PER_CC);
  cutoff = g_metrics_now - METRICS_WINDOW_SEC;
  g_timing_intervals = 0;
  g_timing_p50 = -1; g_timing_p95 = -1;
  g_timing_min = -1; g_timing_max = -1; g_timing_coincident = -1;
  g_timing_jitter = -1; g_timing_jitter_intervals = 0;
  have_previous = 0; zeros = 0; i = 0;
  loop(count,
    time = mem[base + 2 + i * 3];
    time >= 0 && time >= cutoff && time <= g_metrics_now ? (
      have_previous ? (
        interval = time - previous;
        interval >= 0 ? (
          mem[MEM_TIMING_SCRATCH + g_timing_intervals] = interval * 1000;
          g_timing_intervals += 1;
          // EEL2 == is approximate; positive sub-10-us intervals are not zero.
          interval === 0 ? zeros += 1;
        );
      );
      previous = time; have_previous = 1;
    ) : have_previous = 0;
    i += 1;
  );
  g_timing_intervals > 0 ? (
    timing_sort(g_timing_intervals);
    g_timing_min = mem[MEM_TIMING_SCRATCH];
    g_timing_max = mem[MEM_TIMING_SCRATCH + g_timing_intervals - 1];
    g_timing_p50 = mem[MEM_TIMING_SCRATCH + ceil(0.50 * g_timing_intervals) - 1];
    g_timing_p95 = mem[MEM_TIMING_SCRATCH + ceil(0.95 * g_timing_intervals) - 1];
    g_timing_coincident = 100 * zeros / g_timing_intervals;

    // Secondary gap-filtered population SD, on the SAME eligible intervals.
    // If the shortest is zero, only zeros pass: raw gaps remain in p50/p95/max.
    limit = g_timing_min * GAP_FACTOR;
    used = 0; sum = 0; i = 0;
    loop(g_timing_intervals,
      interval = mem[MEM_TIMING_SCRATCH + i];
      interval <= limit ? (sum += interval; used += 1;);
      i += 1;
    );
    g_timing_jitter_intervals = used;
    used >= MIN_JITTER_INTERVALS ? (
      mean = sum / used; squared = 0; i = 0;
      loop(used,
        interval = mem[MEM_TIMING_SCRATCH + i];
        squared += (interval - mean) * (interval - mean);
        i += 1;
      );
      g_timing_jitter = sqrt(squared / used);
    );
  );
  g_timing_p50;
);

init_metrics();
